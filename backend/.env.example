# ---------- Core ----------
MONGO_URI=mongodb://localhost:27017/movie_review_db
# Use a long random string in production, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=your_jwt_secret_key_here
PORT=5000
# Frontend origin(s) allowed by CORS and Socket.IO (comma separated)
CLIENT_URL=http://localhost:4200
# CORS_ORIGINS=http://localhost:4200,https://cinevault.example.com
# Set to false to disable the automatic local mongod fallback when MONGO_URI is unreachable
# MONGO_FALLBACK=true

# ---------- TMDB (optional, recommended) ----------
# https://developer.themoviedb.org/docs/getting-started  ->  Settings > API
# Provide ONE of these. Without them CineVault uses its local catalog only.
TMDB_READ_TOKEN=
TMDB_API_KEY=
# TMDB_CACHE_TTL_MS=1800000

# ---------- AI (optional) ----------
# Every AI feature has a local model. With a Claude API key, CineBot answers with an LLM over
# retrieval tools, Review Intelligence gains style rewrites, CineSpoiler verifies borderline
# sentences and CineSense writes a richer personality narrative.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Force local models even when a key is present
# AI_PROVIDER=local
# Disable LLM verification inside CineSpoiler
# CINESPOILER_LLM=off

# ---------- Rate limits (requests per window) ----------
# AUTH_RATE_LIMIT=60      # per 15 minutes per IP, login/register
# AI_RATE_LIMIT=40        # per minute per IP, /api/ai/*
# WRITE_RATE_LIMIT=240    # per minute per IP, social endpoints

# ---------- Background jobs ----------
# SCHEDULER_INTERVAL_MS=30000   # poll expiry + event reminders

# ---------- Uploads ----------
# UPLOAD_DIR=./uploads
